{
    "name": "Keyword Boss",
    "description": "A SEO tool that provides meta tag information and analysis, it all looks at total word count and keyword frequency",
    "version": "1.0.2",
    "manifest_version": 3,
    "action": {
		"default_popup": "popup.html"
	},
    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["js/getPageMetas.js"]
        }
    ]
}